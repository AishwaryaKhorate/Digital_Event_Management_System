rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // organizer folder
    match /organizer_profile/{userId} {
      allow read: if true; 
      allow write: if request.auth != null && request.auth.uid == userId;
    }
     // Student Folder
    match /profile_images/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Admin Folder (Add this!)
    match /admin_profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // 4. Highlights Folder (student)
 
match /highlights/{allPaths=**} {
  allow read: if true;
  allow write: if request.auth != null;
}
//highlights (organizer)
match /organizer_photos/{allPaths=**} {
  allow read: if true;
  allow write: if request.auth != null;
}


match /posters/{userId}/{allPaths=**} {
      // Allows a user to read/write only if their UID matches the folder name
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
// Certificate

  match /certificates/{allPaths=**} {
      allow read: if true; // Allows the function to fetch the template
      allow write: if request.auth != null;
    }
    match /generated_certificates/{allPaths=**} {
      allow read, write: if true; // Allows public access to sent certificates
    }
  
  }
}